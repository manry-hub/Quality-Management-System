# ==============================================================================
# QMS Environment Configuration Baseline
# Copy this file to .env and replace placeholder values before running.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=replace_with_a_secure_cryptographic_random_key_min_50_chars
ALLOWED_HOSTS=localhost,127.0.0.1,qms.internal.plant,qms-web
CSRF_TRUSTED_ORIGINS=https://qms.internal.plant,http://localhost:8000

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=qms_production
POSTGRES_USER=qms_app_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://qms_app_user:replace_with_a_strong_database_password@db:5432/qms_production

# Redis & Celery Configuration (Redis 7.x)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Machine-to-Machine (M2M) Companion Integrations
MES_BASE_URL=http://mes-gateway.internal.plant:8080
MES_SERVICE_TOKEN=replace_with_cryptographic_bearer_service_token
WMS_BASE_URL=http://wms-gateway.internal.plant:8000
WMS_WEBHOOK_SECRET=replace_with_shared_hmac_sha256_webhook_secret

# Plant Metrology & Security
AUDIT_TRAIL_SALT=replace_with_audit_trail_hashing_salt
ENFORCE_CALIBRATION_LOCKOUT=True
FAIL_SAFE_HOLD_DEFAULT=True
